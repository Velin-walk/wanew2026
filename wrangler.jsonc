{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanew2026",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  },
  "main": "cloudflare/worker.js",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
