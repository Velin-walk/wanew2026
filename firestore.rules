rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Trail moderation decisions (Admin review)
    match /trail_moderation/{trailId} {
      allow read, write: if true;
    }

    // Community trails uploaded by hikers
    match /community_trails/{trailId} {
      allow read, write: if true;
    }

    // Registrations & bookings
    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // System connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Global fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

