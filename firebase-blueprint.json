{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile document stored under users/{userId}",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email"]
    },
    "registration": {
      "title": "Hiker Registration",
      "description": "Trek booking registration by a hiker",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "trekId": { "type": "string", "maxLength": 128 },
        "trekTitle": { "type": "string", "maxLength": 256 },
        "hikerName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 256 },
        "pickupPoint": { "type": "string", "maxLength": 128 },
        "paxCount": { "type": "number" },
        "registeredAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["trekId", "hikerName", "email", "phone"]
    },
    "community_trail": {
      "title": "Community Trail",
      "description": "Map Miners community uploaded GPX or KML track",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "authorEmail": { "type": "string", "maxLength": 256 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "fileUrl": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "authorEmail"]
    },
    "trail_moderation": {
      "title": "Trail Moderation Status",
      "description": "Admin review decisions and approval statuses for community trails",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 32 },
        "moderatedAt": { "type": "string", "maxLength": 64 },
        "moderatedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "status"]
    },
    "trek_photo": {
      "title": "Trek Photo",
      "description": "Community shared photo memories of hikes and treks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "trekId": { "type": "string", "maxLength": 128 },
        "hikeNumber": { "type": "string", "maxLength": 32 },
        "trekName": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 512 },
        "publicId": { "type": "string", "maxLength": 256 },
        "uploadedBy": { "type": "string", "maxLength": 256 },
        "userUid": { "type": "string", "maxLength": 128 },
        "uploadedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["trekId", "url", "uploadedBy", "userUid"]
    },
    "trek": {
      "title": "Trek Itinerary",
      "description": "Trek itinerary details and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "hike_number": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 32 },
        "cover_image_url": { "type": "string", "maxLength": 512 },
        "hike_date": { "type": "string", "maxLength": 64 },
        "min_price": { "type": "number" },
        "max_price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 16 },
        "meeting_point": { "type": "string", "maxLength": 256 },
        "meeting_time": { "type": "string", "maxLength": 64 },
        "expected_duration": { "type": "string", "maxLength": 64 },
        "difficulty": { "type": "string", "maxLength": 64 },
        "approx_distance": { "type": "string", "maxLength": 64 },
        "elevation_range": { "type": "string", "maxLength": 64 },
        "max_capacity": { "type": "number" },
        "author_email": { "type": "string", "maxLength": 256 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "hike_number", "title"]
    },
    "map_chat": {
      "title": "Live Map Chat Message",
      "description": "Live trail radio update/chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 1000 },
        "senderEmail": { "type": "string", "maxLength": 256 },
        "senderName": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "number" }
      },
      "required": ["text", "senderEmail", "senderName", "timestamp"]
    },
    "trail_comment": {
      "title": "Trail Review/Comment",
      "description": "Reviews, notes, and tips posted on individual trails",
      "type": "object",
      "properties": {
        "trailId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 1000 },
        "authorName": { "type": "string", "maxLength": 128 },
        "authorEmail": { "type": "string", "maxLength": 256 },
        "timestamp": { "type": "number" }
      },
      "required": ["trailId", "text", "authorName", "authorEmail", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "User account documents"
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/registration" },
      "description": "Public and user trek registrations"
    },
    "/community_trails/{trailId}": {
      "schema": { "$ref": "#/entities/community_trail" },
      "description": "Map Miners GPX/KML trails"
    },
    "/trail_moderation/{trailId}": {
      "schema": { "$ref": "#/entities/trail_moderation" },
      "description": "Moderation status tracking for submissions"
    },
    "/trek_photos/{photoId}": {
      "schema": { "$ref": "#/entities/trek_photo" },
      "description": "Shared hiker photo gallery and memories"
    },
    "/treks/{trekId}": {
      "schema": { "$ref": "#/entities/trek" },
      "description": "Dual-written trek itineraries"
    },
    "/map_chats/{chatId}": {
      "schema": { "$ref": "#/entities/map_chat" },
      "description": "Live community trail chats"
    },
    "/trail_comments/{commentId}": {
      "schema": { "$ref": "#/entities/trail_comment" },
      "description": "Trail/route reviews and notes comments"
    }
  }
}
